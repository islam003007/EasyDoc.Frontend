# Development/preview proxy target for /api requests.
# The browser only talks to /api; Vite strips the prefix and forwards here.
VITE_API_TARGET=http://localhost:5215

# Optional: bypass the proxy and call an API origin directly.
# That origin must allow credentialed CORS, which the demo API does not enable.
# VITE_API_BASE_URL=http://localhost:5215
